# Referência das variáveis server-side. No Cloudflare Pages/Workers, configure-as
# como secrets/variáveis do projeto ou use .dev.vars no desenvolvimento local.
# NÃO use prefixo VITE_ para estes valores.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
RATE_LIMIT_SALT=

# Notificação opcional de novos pedidos (Resend). O pedido é salvo mesmo se o e-mail falhar.
RESEND_API_KEY=
QUOTE_NOTIFICATION_TO=
QUOTE_NOTIFICATION_FROM=
SITE_URL=
